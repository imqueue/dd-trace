{
  "name": "@imqueue/datadog",
  "version": "3.2.0",
  "type": "module",
  "description": "Datadog APM tracing for @imqueue microservices — an unofficial community integration that drop-in replaces Datadog's own dd-trace package and traces every RPC",
  "keywords": [
    "dd-trace",
    "trace",
    "tracing",
    "datadog",
    "apm",
    "imqueue",
    "imq",
    "rpc",
    "integration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean:dts": "find . -name '*.d.ts' -not -wholename '*node_modules*' -type f -delete",
    "clean:map": "find . -name '*.js.map' -not -wholename '*node_modules*' -type f -delete",
    "clean:js": "find . -name '*.js' -not -wholename '*node_modules*' -not -wholename '*bin*' -type f -delete",
    "clean:build": "rm -rf ./node_modules/@types ; find . -name '*.js.map' -type f -delete ; find . -name '*.ts' -type f -delete",
    "clean:test": "rm -rf .nyc_output coverage",
    "clean:doc": "rm -rf docs",
    "clean": "npm run clean:test ; npm run clean:dts ; npm run clean:map ; npm run clean:js ; npm run clean:doc",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mocha": "c8 mocha",
    "show:test": "/usr/bin/env node --input-type=module -e \"import open from 'open'; open('file://'+process.cwd()+'/coverage/index.html',{wait:false});\"",
    "show:doc": "/usr/bin/env node --input-type=module -e \"import open from 'open'; open('file://'+process.cwd()+'/docs/index.html',{wait:false});\"",
    "test": "npm run build && npm run mocha",
    "doc": "npm run clean && typedoc --excludePrivate --excludeExternals --hideGenerator --out ./docs index.ts && npm run show:doc",
    "help": "npm-scripts-help"
  },
  "author": "imqueue.com <support@imqueue.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imqueue/datadog.git"
  },
  "bugs": {
    "url": "https://github.com/imqueue/datadog/issues"
  },
  "homepage": "https://imqueue.org/",
  "dependencies": {
    "@imqueue/rpc": "^3.4.1",
    "@types/node": "^26.1.1",
    "dd-trace": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/typescript-estree": "^8.65.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "minimist": "^1.2.8",
    "mocha": "^11.7.6",
    "mocha-lcov-reporter": "^1.3.0",
    "npm-scripts-help": "^0.8.0",
    "open": "^11.0.0",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "typescript": {
    "definitions": "index.d.ts"
  },
  "c8": {
    "all": true,
    "check-coverage": false,
    "include": [
      "index.js",
      "src/**/*.js"
    ],
    "exclude": [
      "**/*.d.ts",
      "**/test/**",
      "**/examples/**"
    ],
    "reporter": [
      "html",
      "text",
      "text-summary",
      "lcovonly"
    ]
  }
}
